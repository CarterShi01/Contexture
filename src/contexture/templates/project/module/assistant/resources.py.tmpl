"""The content this role can read.

A resource is a descriptor until somebody asks for its bytes. Listing one costs
a line of description; `read()` runs only when a host performs resources/read.
"""

from __future__ import annotations

from contexture import Resource


class HealthRunbook(Resource):
    """How to interpret a reachability check, and what not to conclude."""

    uri = "$resource_scheme://runbooks/health"
    mime_type = "text/markdown"

    async def read(self) -> str:
        return (
            "# Reading a reachability check\n\n"
            "- **reachable** - the target answered. Nothing to do.\n"
            "- **unreachable** - the target did not answer. Check name\n"
            "  resolution before concluding the service is down.\n\n"
            "Reachable is not the same as healthy.\n"
        )
