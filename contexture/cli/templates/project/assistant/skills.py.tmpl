"""The procedures this role knows.

These instructions are the payload progressive disclosure exists to defer. They
are never in the bootstrap text and never on a routing card; an agent receives
them only after calling contexture_open on this skill's ref.
"""

from __future__ import annotations

from contexture import Skill


class CheckTarget(Skill):
    def __init__(self) -> None:
        super().__init__(
            name="check-target",
            description=(
                "Establish whether a target is reachable before reporting "
                "on it."
            ),
            instructions="""\
Work from evidence, in this order.

1. Call ping with the target you were given.
2. Read $resource_scheme://runbooks/health and match the result against it.
3. Report what you found and the smallest safe next action.

Constraints:
- Do not state a status you have not read from a tool.
- Reachable is not healthy. Say which one you established.
""",
        )
