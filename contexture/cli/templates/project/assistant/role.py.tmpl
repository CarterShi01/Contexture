"""The role a connecting agent discovers first."""

from __future__ import annotations

from contexture import Role

from .skills import CheckTarget
from .tools import Ping


class $role_class(Role):
    def __init__(self) -> None:
        # Identity is handed to the base class, and nothing is inferred from
        # the class name or the docstring: neither is readable at run time in
        # TypeScript or Go.
        #
        # Members are built here, so nothing exists until a manager registers
        # this role. Which of the three lists a capability belongs in is the
        # modelling decision this framework asks you to make.
        super().__init__(
            name="$role_ref",
            description="$role_description",
            instructions="""\
Select the skill that matches the request, follow its procedure, and collect
tool output before stating a conclusion. Report the smallest safe next action.
""",
            skills=[CheckTarget()],
            tools=[Ping()],
        )
