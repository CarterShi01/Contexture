[project]
name = "$project_name"
version = "0.1.0"
description = "A Contexture MCP server."
requires-python = ">=3.10"
dependencies = ["contexture-mcp"]

# This project is served, not distributed: no build system, never installed
# into the environment. `contexture serve` finds it by the table below and puts
# this directory on sys.path.
[tool.uv]
package = false

[tool.contexture]
# The one application declaration. Its name, roots, optional Channels, and
# optional Prompt/Resource declarations live together in $package_name.
app = "$package_name:app"
